# SPA fallback para hospedagem Apache (Hostinger)
# Faz com que rotas como /desvios, /obras, etc. sejam servidas pelo index.html
# para o React Router lidar com elas no client-side.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Não reescrever para arquivos ou diretórios reais (assets, imagens, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todas as outras requisições caem no index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Headers de cache razoáveis para assets com hash
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
